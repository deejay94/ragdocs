# OpenAI — required to embed documents and generate grounded answers
OPENAI_API_KEY=sk-your-key-here

# Optional chat model override (default: gpt-4o-mini)
# CHAT_MODEL=gpt-4o-mini

# Optional per-IP rate limits (requests per minute; in-memory, single process)
# RATE_LIMIT_CHAT_PER_MIN=10
# RATE_LIMIT_RETRIEVE_PER_MIN=30
# RATE_LIMIT_DOCUMENTS_WRITE_PER_MIN=10

# Postgres with pgvector (matches docker-compose.yml defaults)
# Required for migrations, GET /api/health, and document APIs
DATABASE_URL=postgresql://ragdocs:ragdocs@localhost:5432/ragdocs
